# ─── Branding ───────────────────────────────────────────────────────────────
# Product name shown across the UI (configurable without code changes).
NEXT_PUBLIC_APP_NAME="DealDesk"
# Public base URL of the app (used in password-reset links and OAuth callbacks).
APP_URL="http://localhost:3000"

# ─── Database ───────────────────────────────────────────────────────────────
# Local dev: `npm run db:start` runs PostgreSQL on port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/salesflow"
# Used by `npm test` (integration tests truncate this database).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/salesflow_test"

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Required behind proxies / in production so Auth.js trusts the host header.
AUTH_TRUST_HOST=true

# Google sign-in (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
#   {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Enterprise SSO via OpenID Connect (optional). Works with Okta, Microsoft
# Entra ID, Auth0, Keycloak, OneLogin, Google Workspace … Redirect URI:
#   {APP_URL}/api/auth/callback/sso
AUTH_SSO_ISSUER=""
AUTH_SSO_CLIENT_ID=""
AUTH_SSO_CLIENT_SECRET=""
AUTH_SSO_NAME="Company SSO"

# ─── Email (optional) ───────────────────────────────────────────────────────
# When unset, password-reset links are written to the server log in
# development only, and customer ticket replies are stored but not sent.
SMTP_URL=""
EMAIL_FROM="DealDesk <no-reply@example.com>"

# ─── AI assistant (optional) ────────────────────────────────────────────────
# Enables Zeni, the read-only conversational assistant ("Ask Zeni" button),
# powered by Claude. Create a key at https://platform.claude.com. When unset,
# the chat panel explains that the assistant is not enabled.
ANTHROPIC_API_KEY=""
